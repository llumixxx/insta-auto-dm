# 직접 넣는 값은 이 3개뿐이에요
IG_APP_ID=        # 메타 앱 > Instagram > API 설정의 'Instagram 앱 ID'
IG_APP_SECRET=    # 같은 화면의 'Instagram 앱 시크릿 코드'
ADMIN_PASSWORD=   # 관리 페이지 비밀번호 (길게)

# 자동: KV_REST_API_URL / KV_REST_API_TOKEN (Vercel Storage에서 Upstash 연결 시)
# 자동: 배포 주소, 웹훅 확인 토큰, 모델 연결 코드 → 관리 페이지 '메타 앱 설정값'에서 확인
