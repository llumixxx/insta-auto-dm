# 메타 앱 > Instagram > API 설정(Instagram 로그인) 에 있는 값
IG_APP_ID=
IG_APP_SECRET=
# 배포 주소 (끝에 / 없이)  예: https://insta-auto-dm.vercel.app
BASE_URL=
# 웹훅 확인용 아무 문자열 (메타 웹훅 설정의 '확인 토큰'과 똑같이)
WEBHOOK_VERIFY_TOKEN=
# 관리 페이지 비밀번호
ADMIN_PASSWORD=
# 모델에게 보내는 연결 링크용 코드 (아무 문자열)
CONNECT_CODE=
# Vercel이 자동으로 넣어줌 (크론 보호용, 직접 넣어도 됨)
CRON_SECRET=
# Upstash Redis (Vercel Marketplace에서 연결하면 자동 입력)
KV_REST_API_URL=
KV_REST_API_TOKEN=
